{
  "id": "qq-group-listener",
  "name": "QQ Group Policy Pack Engine",
  "description": "QQ multi-group policy packs with hot-reload, batch triggers, mute, and Control UI admin.",
  "version": "0.4.0",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "rootDir": {
        "type": "string",
        "description": "Plugin root containing config/ and packs/."
      },
      "dataDir": {
        "type": "string",
        "description": "Directory for buffer/ and state/."
      },
      "dryRun": {
        "type": "boolean",
        "description": "Log mute actions without calling the platform API."
      },
      "logLevel": {
        "type": "string",
        "enum": [
          "debug",
          "info",
          "warn",
          "error"
        ]
      }
    }
  },
  "controlUi": {
    "entry": "dist/control-ui/9188c5dd7e57b34cd8ac05829b72c442ed90aef18b82e24b57a44b6827f8a49d/index.js",
    "styles": [
      "dist/control-ui/9188c5dd7e57b34cd8ac05829b72c442ed90aef18b82e24b57a44b6827f8a49d/index.css"
    ]
  },
  "contracts": {
    "tools": [
      "qq_group_policy"
    ]
  },
  "toolMetadata": {
    "qq_group_policy": {
      "optional": true
    }
  }
}
