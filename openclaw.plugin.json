{
  "id": "qq-group-listener",
  "name": "Smart QQ Group Listener for OpenClaw",
  "description": "小龙虾的 QQ 群科学冲浪指南：按群策略包决定唤醒/缓冲/禁言/撤回；热重载与 Control UI（侧栏 QQ冲浪指南）。",
  "version": "0.4.0",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "rootDir": {
        "type": "string",
        "description": "Plugin root containing config/ and packs/."
      },
      "dataDir": {
        "type": "string",
        "description": "Directory for buffer/ and state/."
      },
      "dryRun": {
        "type": "boolean",
        "description": "Log mute actions without calling the platform API."
      },
      "logLevel": {
        "type": "string",
        "enum": [
          "debug",
          "info",
          "warn",
          "error"
        ]
      }
    }
  },
  "controlUi": {
    "entry": "dist/control-ui/e836f74fea84fc743ada02b06cfb6de1afe3443fd27a0b5df360cf0978d6e2a5/index.js",
    "styles": [
      "dist/control-ui/e836f74fea84fc743ada02b06cfb6de1afe3443fd27a0b5df360cf0978d6e2a5/index.css"
    ]
  },
  "contracts": {
    "tools": [
      "qq_group_policy"
    ]
  },
  "toolMetadata": {
    "qq_group_policy": {
      "optional": true
    }
  }
}
