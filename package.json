{
  "name": "qq-group-listener",
  "version": "0.4.0",
  "description": "小龙虾的 QQ 群科学冲浪指南（Smart QQ Group Listener for OpenClaw）：按策略包决定唤醒/缓冲/禁言/撤回。",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "config",
    "packs",
    "openclaw.plugin.json",
    "README.md",
    "CONTEXT.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && openclaw plugins build --root . && node scripts/patch-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "openclaw plugins validate --root . --json"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.4"
  },
  "dependencies": {
    "typebox": "^1.3.17",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "0.28.2",
    "openclaw": "^2026.9.5",
    "typescript": "^5.9.0",
    "vitest": "^3.0.9"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": ">=2026.9.5"
    },
    "build": {
      "openclawVersion": "2026.9.5"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
